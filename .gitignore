# Deny-by-default: this repo exists ONLY to host the packaged-app build
# config (Electron/Capacitor) for CI. Everything else in this working
# directory — statement/payslip JSON exports, scratch notes, backups — must
# never be committed, even accidentally via `git add -A`. Only the paths
# explicitly un-ignored below are ever allowed in.
/*
!/app/
!/finforecast-lite.html
!/.gitignore
!/.github/

# Inside app/, ignore installed deps, build output, and the synced copies
# of finforecast-lite.html (regenerated by scripts/sync.js, not source).
app/electron/node_modules/
app/electron/dist/
app/electron/src/index.html
app/mobile/node_modules/
app/mobile/www/index.html
app/mobile/android/build/
app/release-assets/
app/mobile/*.apk
app/mobile/android/app/build/
app/mobile/android/.gradle/
app/mobile/android/local.properties
app/mobile/android/captures/
app/mobile/ios/App/Pods/
app/mobile/ios/App/build/
app/mobile/ios/App/output/
